# Raíz de los datos persistentes (Premium, Freemium, .admin y .locks).
# En Docker debe coincidir con el volumen persistente montado.
DATA_DIR=/app/datos

# Tipo de cambio usado para mostrar el saldo de DeepSeek en euros.
# 1 USD = 0.92 EUR
USD_TO_EUR_RATE=0.92
EMAIL_FROM="OpoGen AI <notificaciones@notificaciones.security-privacy-mask-meta.site>"
NEXT_PUBLIC_APP_URL=https://opogenai.com

# IDs de precio de Stripe (deben coincidir con el modo test/live de la clave).
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_SEMESTRAL=
STRIPE_PRICE_ANUAL=

# Stripe price IDs (deben coincidir con el modo de STRIPE_SECRET_KEY).
# Valores de respaldo actuales:
# mensual: price_1UZMIYEcQCiUR7vYJZCg7gVk
# semestral: price_1UZMRVEcQCiUR7vYYQQIbTRM
# anual: price_1UZMTCEcQCiUR7vYotTPE1oz
STRIPE_PRICE_MENSUAL=
STRIPE_PRICE_SEMESTRAL=
STRIPE_PRICE_ANUAL=
