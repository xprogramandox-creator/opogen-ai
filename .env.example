# Raíz de los datos persistentes (Premium, Freemium, .admin y .locks).
# En Docker debe coincidir con el volumen persistente montado.
DATA_DIR=/app/datos

# Tipo de cambio usado para mostrar el saldo de DeepSeek en euros.
# 1 USD = 0.92 EUR
USD_TO_EUR_RATE=0.92
EMAIL_FROM="OpoGen AI <notificaciones@notificaciones.security-privacy-mask-meta.site>"
NEXT_PUBLIC_APP_URL=https://opogenai.com
