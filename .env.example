# Raíz de los datos persistentes (Premium, Freemium, .admin y .locks).
# En Docker debe coincidir con el volumen persistente montado.
DATA_DIR=/app/datos

# Tipo de cambio usado para mostrar el saldo de DeepSeek en euros.
# 1 USD = 0.92 EUR
USD_TO_EUR_RATE=0.92
EMAIL_FROM="OpoGen AI <notificaciones@notificaciones.security-privacy-mask-meta.site>"
NEXT_PUBLIC_APP_URL=https://opogenai.com

# Los precios de Stripe se definen de forma fija en lib/stripe-precios.ts.
# No se usan variables STRIPE_PRICE_* para evitar IDs obsoletos.

# Detección del país por IP para elegir el idioma inicial.
# Ponlo en "off" para desactivarla sin desplegar código (rollback inmediato).
IP_LOCALE_DETECTION=on

# Ruta del mmdb de MaxMind. Por defecto: ${DATA_DIR}/geolite2/GeoLite2-Country.mmdb.
# GEOLITE2_DB_PATH=/app/datos/geolite2/GeoLite2-Country.mmdb

# API de respaldo si el mmdb no está disponible (ipapi.co por defecto).
# IP_LOCALE_API=https://ipapi.co
